#version 450

// Single-row split SWIGLU (silu(a) * b) that also writes the result as block_q8_1_x4,
// so the following MMVQ matmul can skip its own quantize dispatch and barrier.
// Each thread handles one vec4, 8 threads form one q8_1 block of 32 values.

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require

#include "types.glsl"

layout (push_constant) uniform parameter {
    uint ne;
} p;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {vec4 data_a[];};
layout (binding = 1) readonly buffer B {vec4 data_b[];};
layout (binding = 2) writeonly buffer D {vec4 data_d[];};
layout (binding = 3) writeonly buffer Q {block_q8_1_x4 data_q[];};

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    // ne % 128 == 0, so whole 8-lane clusters are in or out of range
    if (idx >= p.ne / 4) {
        return;
    }
    const vec4 a = data_a[idx];
    const vec4 b = data_b[idx];
    const vec4 o = a / (1.0f + exp(-a)) * b;
    data_d[idx] = o;

    const vec4 ao = abs(o);
    const float amax = subgroupClusteredMax(max(max(ao.x, ao.y), max(ao.z, ao.w)), 8);
    const float d = amax / 127.0;
    const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
    const vec4 qv = round(o * d_inv);
    const uint ib = idx / 8;
    const uint iqs = idx % 8;
    data_q[ib / 4].qs[(ib % 4) * 8 + iqs] = pack32(i8vec4(qv));
    const float qsum = subgroupClusteredAdd(qv.x + qv.y + qv.z + qv.w, 8);
    if (iqs == 0) {
        data_q[ib / 4].ds[ib % 4] = f16vec2(vec2(d, qsum * d));
    }
}
